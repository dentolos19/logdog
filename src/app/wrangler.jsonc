{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logdog",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "dev": {
    "enable_containers": false,
  },
  "observability": {
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
    "issues": {
      "enabled": true,
    },
  },
  "route": {
    "pattern": "logdog.dennise.me",
    "custom_domain": true,
  },
  "containers": [
    {
      "name": "logdog-server",
      "class_name": "Server",
      "image": "../server/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVER",
        "class_name": "Server",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Server"],
    },
  ],
}
