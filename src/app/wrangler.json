{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logdog",
  "main": "src/server.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "enable_containers": false
  },
  "observability": {
    "enabled": true
  },
  "route": {
    "pattern": "logdog.dennise.me",
    "custom_domain": true
  },
  "containers": [
    {
      "name": "logdog-server",
      "class_name": "Server",
      "image": "../server/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVER",
        "class_name": "Server"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Server"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "logdog"
    }
  ]
}
